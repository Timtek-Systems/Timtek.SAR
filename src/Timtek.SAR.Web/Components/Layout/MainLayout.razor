@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<div class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">
                <strong>Timtek SAR</strong>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">Home</NavLink>
                    </li>
                    <AuthorizeView>
                        <Authorized>
                            <AuthorizeView Roles="Administrator" Context="adminAuth">
                                <li class="nav-item">
                                    <NavLink class="nav-link" href="/admin/organisation">Organisation</NavLink>
                                </li>
                                <li class="nav-item">
                                    <NavLink class="nav-link" href="/admin/users">Users</NavLink>
                                </li>
                            </AuthorizeView>
                        </Authorized>
                    </AuthorizeView>
                </ul>
                <ul class="navbar-nav ms-auto">
                    <AuthorizeView>
                        <Authorized>
                            <li class="nav-item">
                                <span class="nav-link text-light">@context.User.Identity?.Name</span>
                            </li>
                            <li class="nav-item">
                                <NavLink class="nav-link" href="/logout">Logout</NavLink>
                            </li>
                        </Authorized>
                        <NotAuthorized>
                            <li class="nav-item">
                                <NavLink class="nav-link" href="/login">Login</NavLink>
                            </li>
                            <li class="nav-item">
                                <NavLink class="nav-link" href="/register">Register</NavLink>
                            </li>
                        </NotAuthorized>
                    </AuthorizeView>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container flex-grow-1 py-4">
        @Body
    </main>

    <footer class="bg-light text-muted py-3 mt-auto">
        <div class="container text-center">
            <small>&copy; Timtek SAR Case Manager</small>
        </div>
    </footer>
</div>
