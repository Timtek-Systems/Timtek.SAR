@page "/admin/users"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Timtek.SAR.Application.OrganisationManagement
@using Timtek.SAR.Application.UserManagement
@using Timtek.SAR.Application.UserManagement.Dtos
@using Timtek.SAR.Domain.Enums
@attribute [Authorize(Roles = "Administrator")]
@inject IUserService UserService
@inject IOrganisationService OrganisationService

<PageTitle>User Management — Timtek SAR</PageTitle>

<h2>User Management</h2>

@if (_loading)
{
    <p>Loading users…</p>
}
else if (_users.Count == 0)
{
    <p class="text-muted">No users found.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Roles</th>
                <th>Active</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in _users)
            {
                <tr>
                    <td>@user.DisplayName</td>
                    <td>@user.Email</td>
                    <td>@string.Join(", ", user.Roles)</td>
                    <td>
                        @if (user.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td>
                        @if (user.IsActive)
                        {
                            <button class="btn btn-sm btn-warning" @onclick="() => DeactivateUser(user.Id)">Deactivate</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-success" @onclick="() => ActivateUser(user.Id)">Activate</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (!string.IsNullOrEmpty(_statusMessage))
{
    <div class="alert alert-info mt-3">@_statusMessage</div>
}

@code {
    private List<UserDto> _users = [];
    private bool _loading = true;
    private string? _statusMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        _loading = true;
        var org = await OrganisationService.GetFirstOrganisationAsync();
        if (org.Any())
        {
            _users = (await UserService.GetByOrganisationAsync(org.Single().Id)).ToList();
        }
        _loading = false;
    }

    private async Task DeactivateUser(Guid userId)
    {
        await UserService.DeactivateAsync(userId);
        _statusMessage = "User deactivated.";
        await LoadUsers();
    }

    private async Task ActivateUser(Guid userId)
    {
        await UserService.ActivateAsync(userId);
        _statusMessage = "User activated.";
        await LoadUsers();
    }
}
